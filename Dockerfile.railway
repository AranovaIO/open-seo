# Railway-optimized Dockerfile: runs `vite build` at image build time so cold
# wakes under Railway App Sleeping start in seconds instead of running a 4 GB
# build on every wake. Keeps `db:migrate:local` in CMD because Railway only
# mounts the persistent `/app/.wrangler` volume at runtime, not preDeploy.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

ARG AUTH_MODE=local_noauth
ARG VITE_SHOW_DEVTOOLS=false
ENV AUTH_MODE=$AUTH_MODE
ENV VITE_SHOW_DEVTOOLS=$VITE_SHOW_DEVTOOLS

RUN NODE_OPTIONS=--max-old-space-size=4096 pnpm run build

EXPOSE 3001

CMD ["sh", "-c", "pnpm run db:migrate:local && pnpm exec vite preview --host 0.0.0.0 --port ${PORT:-3001}"]
